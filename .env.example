# Copy to .env.local (gitignored). Never commit real values.
# No variable in this project may use the NEXT_PUBLIC_ prefix.

# Canonical site origin, e.g. https://example.com (used for metadata, sitemap, hreflang).
# Falls back to Vercel's production URL, then http://localhost:3000.
SITE_URL=

# Confidential leak-check blocklist: base64 of newline-separated UTF-8 terms.
# Create with: pnpm leak:encode < /path/outside/repo/terms.txt
# Set the same value as a GitHub Actions secret and a Vercel Sensitive env var.
# Leave empty here; put the real value only in .env.local or your shell.
LEAK_CHECK_TERMS_B64=
