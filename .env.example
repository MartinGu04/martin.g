# Copy to .env.local (gitignored). Never commit real values.
# No variable in this project may use the NEXT_PUBLIC_ prefix.

# Canonical site origin, e.g. https://example.com (used for metadata, sitemap, hreflang,
# robots.txt and structured data). An origin only: no path, query or trailing segments.
# Falls back to Vercel's production URL (the shortest production custom domain, else the
# vercel.app domain), then http://localhost:3000. A Vercel production build refuses an
# origin that is not https or is localhost. Set it on Vercel once the final domain is known.
SITE_URL=

# Confidential leak-check blocklist: base64 of newline-separated UTF-8 terms.
# Create with: pnpm leak:encode < /path/outside/repo/terms.txt
# Set the same value as a GitHub Actions secret and a Vercel Sensitive env var.
# Leave empty here; put the real value only in .env.local or your shell.
LEAK_CHECK_TERMS_B64=

# Contact form delivery (Phase 6, src/lib/contact/notifiers.ts). Server-side only.
# Email through Resend is the primary channel; a Vercel production build fails until it is
# configured. Mark the key Sensitive on Vercel. CONTACT_EMAIL_FROM must be a sender Resend
# accepts: an address on a domain verified in Resend, or onboarding@resend.dev, which only
# delivers to the Resend account's own email address.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
# Optional phone ping through a Telegram bot. Update the privacy copy before turning it on.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
