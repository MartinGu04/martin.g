{
  "name": "martin-g-film",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "audio": "node scripts/export-cues.ts && python3 audio/build.py",
    "studio": "pnpm assets && remotion studio src/index.ts",
    "render:desktop": "node scripts/render.mjs desktop",
    "render:mobile": "node scripts/render.mjs mobile",
    "render": "node scripts/render.mjs desktop && node scripts/render.mjs mobile",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@remotion/bundler": "4.0.532",
    "remotion": "4.0.532",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/node": "^22.20.4",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
